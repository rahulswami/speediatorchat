{
  "name": "speediator",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "prisma": "pnpm --filter @speediator/prisma prisma",
    "migrate:dev": "pnpm --filter @speediator/prisma migrate:dev",
    "migrate:prod": "pnpm --filter @speediator/prisma migrate:prod",
    "seed": "pnpm --filter @speediator/prisma seed"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "prettier": "^3.3.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "msgpackr-extract",
      "prisma"
    ]
  }
}
