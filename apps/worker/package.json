{
  "name": "@speediator/worker",
  "version": "0.1.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/apps/worker/src/main",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand --forceExit"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-fastify": "^10.4.0",
    "@nestjs/terminus": "^10.2.3",
    "@speediator/prisma": "workspace:*",
    "@speediator/types": "workspace:*",
    "@speediator/whatsapp": "workspace:*",
    "bullmq": "^5.25.0",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.6.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "@speediator/prisma": "<rootDir>/../../../packages/prisma/src/index.ts",
      "@speediator/types": "<rootDir>/../../../packages/types/src/index.ts",
      "@speediator/whatsapp": "<rootDir>/../../../packages/whatsapp/src/index.ts"
    }
  }
}
